# Prompt Stash — environment configuration
# Copy this file to `.env` for local development.
# Never commit `.env`. Never put a service-role key here or anywhere in the frontend.

# Your Supabase project URL, e.g. https://yourproject.supabase.co
VITE_SUPABASE_URL=

# Your Supabase publishable/anon key (safe for the browser; RLS enforces access).
# Newer Supabase projects use `sb_publishable_...`; older ones use `eyJ...` (anon).
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional E2E test account (used only by Playwright specs, never shipped)
E2E_EMAIL=
E2E_PASSWORD=
